# 数据库（需带 pgvector 扩展）
LF_DATABASE_URL=postgresql+psycopg://lostfound:lostfound@localhost:5432/lostfound
LF_CONFIG_DIR=./config

# LLM Provider: rule（默认，零外部依赖） | openai_compatible
LF_LLM_PROVIDER=rule
# LF_LLM_BASE_URL=https://your-gateway.internal
# LF_LLM_MODEL=your-model
# LF_LLM_API_KEY=

# Embedding Provider: hashing（默认） | local | openai_compatible
LF_EMBEDDING_PROVIDER=hashing
LF_EMBEDDING_MODEL=hashing-1536-v1
LF_EMBEDDING_MODEL_VERSION=v1
LF_EMBEDDING_DIM=1536

# 检索漏斗
LF_STRUCTURED_LIMIT=5000
LF_KEYWORD_LIMIT=500
LF_VECTOR_LIMIT=500
LF_RRF_K=60
LF_SCORING_LIMIT=200
LF_RERANK_LIMIT=20
LF_ALGORITHM_VERSION=lf-matching-v1.0
